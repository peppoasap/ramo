{
  "name": "ramo",
  "version": "0.2.0-beta.2",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "desktop": "tauri dev",
    "bundle": "tauri build",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "test:git": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --locked -- --test-threads=4",
    "format": "prettier --write src scripts vite.config.ts",
    "icons": "node scripts/icons.mjs && tauri icon assets/icon.png --output src-tauri/icons",
    "package:mac:local": "bash scripts/package-macos-local.sh",
    "bench:git": "cargo run --release --manifest-path src-tauri/Cargo.toml --no-default-features --locked --example performance",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "bench:history": "node scripts/benchmark-history-render.mjs",
    "bench:delivery": "cargo run --release --manifest-path src-tauri/Cargo.toml --no-default-features --locked --offline --example delivery_performance",
    "check:release": "node scripts/check-release.mjs",
    "prepare:source": "python3 scripts/prepare-beta-source.py"
  },
  "dependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.10.0",
    "codemirror": "6.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
